{
  "version": 1,
  "description": "Carbon baseline security policy. Forbidden patterns scanned by `carbon scan` and blocked by the pre-commit hook. Extend per project; never weaken to pass a check.",
  "secrets": [
    "-----BEGIN (?:RSA|EC|OPENSSH|DSA|PGP) PRIVATE KEY-----",
    "(?i)aws_secret_access_key\\s*[:=]\\s*[\"']?[A-Za-z0-9/+]{20,}",
    "(?i)\\b(?:api[_-]?key|secret|token)\\b\\s*[:=]\\s*[\"'][A-Za-z0-9_\\-]{16,}[\"']",
    "(?i)password\\s*[:=]\\s*[\"'][^\"']{6,}[\"']",
    "gh[pousr]_[A-Za-z0-9]{20,}",
    "xox[baprs]-[A-Za-z0-9-]{10,}",
    "AKIA[0-9A-Z]{16}"
  ],
  "unsafe_shell": [
    "curl[^|\\n]*\\|\\s*(?:sudo\\s+)?(?:ba)?sh\\b",
    "wget[^|\\n]*\\|\\s*(?:sudo\\s+)?(?:ba)?sh\\b",
    "eval\\s+[\"']?\\$\\(",
    "rm\\s+-rf\\s+/(?:\\s|$|\\*)"
  ]
}
